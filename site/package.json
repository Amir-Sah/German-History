{
  "name": "german-history-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Source-critical interactive website generated from the German history knowledge base (../).",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && astro dev",
    "build": "npm run content && astro build && pagefind --site dist",
    "preview": "astro preview",
    "qa": "node qa/run-all.mjs",
    "images:download": "node scripts/download-images.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.5",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "linkinator": "^8.1.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0"
  }
}
