---
// Page shell: header (nav, "How do we know?", highlight toggle, theme), optional time ribbon, footer,
// and — on pages that pass dictIds — the data for the inline dictionary (tooltip + card dialog).
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '../styles/global.css';
import DictData from '../components/DictData.astro';

interface Props {
  title: string;
  description?: string;
  mood?: string | null;
  calm?: boolean;
  dictIds?: string[];
}
const { title, description, mood, calm = false, dictIds = [] } = Astro.props;
const path = Astro.url.pathname;
// UI labels are site wording (CONTENT_TRACE.md U1–U3, U20). Only pages that exist in this build are listed.
const nav = [
  { href: '/eras/', label: 'Eras' },
  { href: '/dictionary/', label: 'Dictionary' },
  { href: '/how-we-know/audit/', label: 'Source audit' },
];
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · German History, Explained</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before paint: theme, "How do we know?" layer, highlight preference, JS flag. Storage access is guarded.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var get = function (k) {
          try { return localStorage.getItem(k); } catch (e) { return null; }
        };
        var t = get('ghx-theme');
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        if (get('ghx-evidence') === '1') d.classList.add('evidence-on');
        if (get('ghx-highlight') === '0') d.classList.add('dx-off');
        // Hotlinked images can fail (holder offline, blocked network). Swap in the credit card.
        document.addEventListener('error', function (e) {
          var img = e.target;
          if (img && img.tagName === 'IMG' && img.closest('.fig-media')) img.closest('.fig-media').classList.add('failed');
        }, true);
        // Once an image has loaded, the placeholder card behind it is hidden (it showed beside narrow images).
        document.addEventListener('load', function (e) {
          var img = e.target;
          if (img && img.tagName === 'IMG' && img.closest('.fig-media')) img.closest('.fig-media').classList.add('loaded');
        }, true);
      })();
    </script>
  </head>
  <body class:list={[mood && `mood-${mood}`, calm && 'calm']}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/"><span>German History,</span> <span>Explained</span></a>
        <button type="button" class="tool menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
          <span class="visually-hidden">Menu</span>
        </button>
        <div class="menu" id="site-menu">
          <nav aria-label="Site">
            <ul>
              {nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="menu-tools">
            <button type="button" class="tool highlight-toggle" aria-pressed="true" data-highlight-toggle>
              <span class="hl-sample" aria-hidden="true">Aa</span>Highlight names &amp; terms
            </button>
            <button type="button" class="tool theme-toggle" data-theme-toggle aria-label="Colour theme: automatic">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3z"/><circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              <span class="theme-label">Auto</span>
            </button>
          </div>
        </div>
        <button type="button" class="tool evidence-toggle" aria-pressed="false" data-evidence-toggle>
          <span class="tool-dot" aria-hidden="true"></span>How do we know?
        </button>
      </div>
      <slot name="ribbon" />
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Every historical sentence on this site is generated from the Markdown knowledge base{' '}
          <em>German History — A Source-Critical Knowledge Base</em> (compiled September 2026). New site wording is listed in{' '}
          <code>site/CONTENT_TRACE.md</code>.
        </p>
        <p>
          Images are not stored on this site: they are linked from the institutions that hold them, and each carries its own
          credit and licence. All rights to the images belong to their holders. Any image will be taken down on request:{' '}
          <a href="https://github.com/Amir-Sah/German-History/issues">open an issue</a>.
        </p>
      </div>
    </footer>
    {dictIds.length > 0 && <DictData ids={dictIds} />}
    <script>
      import '../scripts/site.ts';
      import '../scripts/dictionary.ts';
    </script>
  </body>
</html>
