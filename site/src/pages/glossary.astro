---
import Base from '../layouts/Base.astro';
import { glossary } from '../lib/content';
const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'de'));
---
<Base title="Glossary">
  <div class="wrap page">
    <h1>Glossary</h1>
    <p class="lead-small">German terms, each explained in the words the knowledge base itself uses, with the place where the explanation appears. The glossary grows as the chapters are rolled out.</p>
    <dl class="glossary">
      {terms.map((t) => (
        <div class="gl-entry" id={t.id}>
          <dt lang="de">{t.term}{t.forms.length > 1 && <span class="muted small"> (also: {t.forms.slice(1).join(', ')})</span>}</dt>
          <dd>{t.gloss}<span class="gl-where">Explained in <code>{t.source}</code>, line {t.sourceLine}</span></dd>
        </div>
      ))}
    </dl>
  </div>
</Base>
