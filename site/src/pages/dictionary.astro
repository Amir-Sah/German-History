---
import Base from '../layouts/Base.astro';
import { dictionary, kbTitles, kbHref } from '../lib/content';

const strip = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const KIND: Record<string, string> = { person: 'Person', place: 'Place', term: 'Term' };
const sorted = [...dictionary].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
const letterOf = (name: string) => {
  const c = strip(name).replace(/[^a-z0-9]/g, '')[0];
  return c && /[a-z]/.test(c) ? c.toUpperCase() : '#';
};
const groups = new Map<string, typeof sorted>();
for (const e of sorted) {
  const l = letterOf(e.name);
  if (!groups.has(l)) groups.set(l, []);
  groups.get(l)!.push(e);
}
const letters = [...groups.keys()].sort((a, b) => (a === '#' ? -1 : b === '#' ? 1 : a.localeCompare(b)));
const title = (f: string) => kbTitles[f] ?? f;
const counts = { person: 0, place: 0, term: 0 } as Record<string, number>;
for (const e of dictionary) counts[e.kind]++;
---

<Base title="Dictionary" description="People, places and terms named in the knowledge base, with short and longer explanations.">
  <div class="wrap page dict">
    <p class="kicker">Reference</p>
    <h1>Dictionary</h1>
    <p class="lead-small">
      People, places and terms named in the knowledge base, with the short and longer explanations from its dictionary (dictionary/*.md).
    </p>
    <p class="muted small">
      Entries marked KB+K combine knowledge-base text with well-established general knowledge, such as birth and death dates from standard
      reference works. Switch on "How do we know?" to see each entry's basis.
    </p>

    <div class="dict-tools" role="group" aria-label="Filter the dictionary">
      <div class="dict-kinds" role="group" aria-label="Kinds of entry">
        <button type="button" class="dict-kind" data-kind-btn="person" aria-pressed="true">People</button>
        <button type="button" class="dict-kind" data-kind-btn="place" aria-pressed="true">Places</button>
        <button type="button" class="dict-kind" data-kind-btn="term" aria-pressed="true">Terms</button>
      </div>
      <div class="dict-search">
        <label for="dict-q">Search the dictionary</label>
        <input id="dict-q" type="search" autocomplete="off" placeholder="Name, German form or description" />
      </div>
      <p class="small muted" id="dict-count" aria-live="polite">{dictionary.length} entries shown</p>
    </div>

    <nav class="dict-letters" aria-label="Letters">
      {letters.map((l) => <a href={`#letter-${l === '#' ? 'num' : l}`}>{l}</a>)}
    </nav>

    <p id="dict-none" class="muted" hidden>No entries match.</p>

    {letters.map((l) => (
      <section class="dict-group" aria-labelledby={`letter-${l === '#' ? 'num' : l}`}>
        <h2 id={`letter-${l === '#' ? 'num' : l}`} class="dict-letter">{l}</h2>
        {groups.get(l)!.map((e) => {
          const contested = e.note && /CONTESTED/.test(e.note);
          const noteRest = e.note ? e.note.replace(/CONTESTED/g, '').replace(/^[\s.,;:–—-]+/, '').trim() : '';
          const mainHref = e.main ? kbHref(e.main) : null;
          // Only spellings that are not already visible are stored; the rest of the search text is read from the page.
          const extra = (e.forms ?? []).filter((f) => f !== e.name).join(' · ');
          return (
            <article class="dict-entry" id={e.id} data-kind={e.kind} data-forms={extra || undefined}>
              <h3 class={`dn dn-${e.kind}`}>
                {e.kind === 'place' && (
                  <svg class="pin" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.500a2.5 2.5 0 0 1 0 5z"/></svg>
                )}
                {e.name}
              </h3>
              <p class="meta small">
                <span class="chip">{KIND[e.kind]}</span>
                {e.subkind && <span class="muted">{e.subkind}</span>}
                {e.dates && <span class="dates">{e.dates}</span>}
                {e.german && <span class="de" lang="de">{e.german}</span>}
              </p>
              {e.short && <p class="short">{e.short}</p>}
              {e.explanation && <p class="expl">{e.explanation}</p>}
              {e.note && (
                <p class="note">
                  <span class="note-l">Note:</span> {contested && <span class="conf conf-contested">CONTESTED</span>}
                  {noteRest && ` ${noteRest}`}
                </p>
              )}
              {e.main && (
                <p class="small main">
                  <span class="muted">Main chapter:</span>{' '}
                  {mainHref ? <a href={mainHref}>{title(e.main)}</a> : <span class="unbuilt">{title(e.main)}</span>}
                </p>
              )}
              {e.also && e.also.length > 0 && (
                <p class="small also">
                  <span class="muted">Also in:</span>
                  {e.also.map((f) => {
                    const h = kbHref(f);
                    return h ? <a class="chip" href={h}>{title(f)}</a> : <span class="chip">{title(f)}</span>;
                  })}
                </p>
              )}
              {e.basis && (
                <p class="ev-only small"><span class="chip">Basis: {e.basis}</span></p>
              )}
            </article>
          );
        })}
      </section>
    ))}
  </div>
</Base>

<style is:global>
  /* global (not scoped) to keep the 2,300-entry page small: no per-element scope attributes */
  .dict .unbuilt::after { content: ' (chapter not built yet)'; color: var(--muted); }
  .dict h1 { margin: 0.2rem 0 0.6rem; }
  .dict .dict-tools { display: grid; gap: 0.75rem; margin: 1.25rem 0 0.75rem; padding: 0.9rem; background: var(--paper-2); border: 1px solid var(--rule); border-radius: var(--radius); }
  .dict .dict-kinds { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dict .dict-kind { font-family: var(--sans); font-size: 0.9rem; font-weight: 600; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius); border: 1px solid var(--rule); background: var(--paper); color: var(--ink-2); cursor: pointer; }
  .dict .dict-kind[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .dict .dict-kind:focus-visible, .dict .dict-search input:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }
  .dict .dict-search label { display: block; font-family: var(--sans); font-size: 0.85rem; font-weight: 600; color: var(--ink); margin-bottom: 0.25rem; }
  .dict .dict-search input { width: 100%; max-width: 28rem; box-sizing: border-box; min-height: 2.5rem; padding: 0 0.75rem; font: inherit; font-family: var(--sans); color: var(--ink); background: var(--paper); border: 1px solid var(--muted); border-radius: var(--radius); }
  .dict #dict-count { margin: 0; }
  .dict .dict-letters { display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0.5rem 0 1.5rem; }
  .dict .dict-letters a { display: inline-flex; align-items: center; justify-content: center; min-width: 2.25rem; min-height: 2.25rem; font-family: var(--sans); font-weight: 600; border: 1px solid var(--rule); border-radius: var(--radius); text-decoration: none; }
  .dict .dict-letters a:hover { background: var(--paper-2); }
  .dict .dict-letter { font-family: var(--serif); font-size: 1.8rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.2rem; margin: 2rem 0 0.5rem; scroll-margin-top: 8rem; }
  .dict .dict-entry { scroll-margin-top: 8rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); max-width: 46rem; overflow-wrap: anywhere; }
  .dict .dict-entry[hidden], .dict .dict-group[hidden] { display: none; }
  .dict .dict-entry h3 { margin: 0; font-size: 1.2rem; line-height: 1.3; }
  .dict .dn-person { color: var(--dx-person); font-variant: small-caps; letter-spacing: 0.02em; }
  .dict .dn-place { color: var(--dx-place); }
  .dict .dn-term { color: var(--dx-term); }
  .dict .pin { vertical-align: -0.1em; margin-right: 0.3em; }
  .dict .dict-entry p { margin: 0.35rem 0 0; }
  .dict .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; }
  .dict .meta .chip { vertical-align: baseline; }
  .dict .meta .de { font-style: italic; color: var(--ink-2); }
  .dict .meta .dates { color: var(--ink-2); }
  .dict .short { font-weight: 600; color: var(--ink); }
  .dict .expl { color: var(--ink-2); }
  .dict .note { padding: 0.4rem 0.6rem; border-left: 3px solid var(--ink-2); background: var(--paper-2); color: var(--ink); font-size: 0.95rem; }
  .dict .note-l { font-family: var(--sans); font-weight: 700; }
  .dict .also { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; }
  .dict .also .chip { white-space: normal; text-decoration: none; }
  .dict .also a.chip { color: var(--link); }
</style>

<script>
  const strip = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.dict-entry'));
  const text = new Map(entries.map((e) => [e, strip([e.querySelector('h3')?.textContent, e.dataset.forms, e.querySelector('.de')?.textContent, e.querySelector('.short')?.textContent].join(' '))]));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.dict-group'));
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kind-btn]'));
  const q = document.getElementById('dict-q') as HTMLInputElement;
  const count = document.getElementById('dict-count')!;
  const none = document.getElementById('dict-none')!;
  const apply = () => {
    const on = new Set(btns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.kindBtn));
    const terms = strip(q.value).split(/\s+/).filter(Boolean);
    let n = 0;
    for (const e of entries) {
      const s = text.get(e) || '';
      const show = on.has(e.dataset.kind) && terms.every((t) => s.includes(t));
      e.hidden = !show;
      if (show) n++;
    }
    for (const g of groups) g.hidden = !g.querySelector('.dict-entry:not([hidden])');
    none.hidden = n > 0;
    count.textContent = `${n} ${n === 1 ? 'entry' : 'entries'} shown`;
  };
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      apply();
    }),
  );
  q.addEventListener('input', apply);
</script>
