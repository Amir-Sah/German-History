---
// Temporary home: links to all era chapters by group. The Journey (00_FINAL_EXPLANATION.md) replaces this page next.
import Base from '../layouts/Base.astro';
import TimeRibbon from '../components/TimeRibbon.astro';
import { periods, method, eraHref } from '../lib/content';
const groups = method.groups.map((g) => ({ ...g, items: periods.filter((p) => p.group === g.id) }));
---
<Base title="Home">
  <TimeRibbon slot="ribbon" />
  <div class="wrap page">
    <p class="kicker">Build preview</p>
    <h1>German History, Explained</h1>
    <p class="lead-small">
      All 35 era chapters are built. The Journey through the ten Parts of <code>00_FINAL_EXPLANATION.md</code> becomes this
      home page in the next step.
    </p>
    {groups.map((g) => (
      <section aria-labelledby={`h-${g.id}`}>
        <h2 id={`h-${g.id}`} class="kicker">{g.label}</h2>
        <ul class="card-list">
          {g.items.map((p) => (
            <li class="card"><a href={eraHref(p.slug) ?? '#'}><span class="card-title">{p.title}</span><span class="card-date">{p.dateLabel}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
    <p><a href="/dictionary/">Dictionary</a> · <a href="/how-we-know/">How the research was done</a> · <a href="/how-we-know/audit/">Source audit</a></p>
  </div>
</Base>
