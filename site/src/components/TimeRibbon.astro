---
// Persistent ribbon: 2,500 years on a LINEAR scale (so the reader sees true proportions), era-group
// bands, the war ruptures named in 00_FINAL_EXPLANATION.md, and the current chapter's span.
import { method, RIBBON, fmtYear, type Period } from '../lib/content';

interface Props {
  current?: Period;
  // Journey (home): the marker follows the Part being read (src/scripts/journey.ts); starts hidden.
  journey?: boolean;
}
const { current, journey = false } = Astro.props;
const W = RIBBON.to - RIBBON.from;
const pct = (y: number) => ((y - RIBBON.from) / W) * 100;
const groups = method.groups;
const ticks = [-500, 0, 500, 1000, 1500, 2000];
---

<div class:list={['ribbon', !current && !journey && 'ribbon-bare', journey && 'ribbon-journey']} role="group" aria-label="Time ribbon, 500 BCE to 2026" data-ribbon>
  <div class="ribbon-track" aria-hidden="true">
    {
      groups.map((g, i) => (
        <span
          class:list={['ribbon-band', `band-${g.id}`, current?.group === g.id && 'is-current']}
          style={`left:${pct(Math.max(g.from, RIBBON.from))}%;width:${pct(g.to) - pct(Math.max(g.from, RIBBON.from))}%;--lane:${i % 2}`}
          title={g.label}
        />
      ))
    }
    {method.ruptures.map((y) => <span class="ribbon-rupture" style={`left:${pct(y)}%`} title={`${y}`} />)}
    {journey && <span class="ribbon-here" hidden data-ribbon-here />}
    {
      current && (
        <span
          class="ribbon-here"
          style={`left:${pct(current.span.start)}%;width:max(4px, ${pct(current.span.end) - pct(current.span.start)}%)`}
        />
      )
    }
    {ticks.map((y, i) => <span class:list={['ribbon-tick', i === 0 && 'first']} style={`left:${pct(y)}%`}>{y < 0 ? `${-y} BCE` : y === 0 ? '0' : y}</span>)}
  </div>
  {
    journey && (
      <p class="ribbon-label" aria-live="polite">
        <span class="visually-hidden">You are here: </span>
        <span class="ribbon-where" data-ribbon-where>{fmtYear(RIBBON.from)} – {RIBBON.to}</span>
      </p>
    )
  }
  {
    current && (
      <p class="ribbon-label">
        <span class="visually-hidden">You are here: </span>
        <span class="ribbon-where">{current.dateLabel}</span>
        <span class="ribbon-of"> within {fmtYear(RIBBON.from)} – {RIBBON.to}</span>
      </p>
    )
  }
</div>
